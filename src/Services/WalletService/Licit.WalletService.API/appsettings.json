{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/wallet-service-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "Licit.WalletService"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "Licit.AuthService",
    "Audience": "Licit.Client"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=LicitDev2024!"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "Currency": "try",
    "MinimumAmount": 1,
    "MaximumAmount": 100000
  },
  "InternalService": {
    "ServiceKey": ""
  }
}
