<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Licit.WalletService.Application\Licit.WalletService.Application.csproj" />
    <ProjectReference Include="..\Licit.WalletService.Infrastructure\Licit.WalletService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
