          "tendering-service": {
            "Address": "http://localhost:5132/"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": {
            "Address": "http://localhost:5142/"
          }
        }
      },
      "mail-cluster": {
