{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Redis": {
      "KeyPrefix": "gateway:ratelimit"
    },
    "BypassPaths": [
      "/gateway",
      "/health"
    ],
    "Policies": [
      {
        "Name": "auth",
        "PathPrefix": "/api/auth",
        "PermitLimit": 5,
        "WindowSeconds": 60
      },
      {
        "Name": "bids",
        "PathPrefix": "/api/bids",
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      {
        "Name": "api",
        "PathPrefix": "/api",
        "PermitLimit": 60,
        "WindowSeconds": 60
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "tendering-route": {
        "ClusterId": "tendering-cluster",
        "Match": {
          "Path": "/api/tender/{**catch-all}"
        }
      },
      "auction-route": {
        "ClusterId": "auction-cluster",
        "Match": {
          "Path": "/api/auction"
        }
      },
      "auction-catchall-route": {
        "ClusterId": "auction-cluster",
        "Match": {
          "Path": "/api/auction/{**catch-all}"
        }
      },
      "bids-route": {
        "ClusterId": "bidding-cluster",
        "Match": {
          "Path": "/api/bids"
        }
      },
      "bids-catchall-route": {
        "ClusterId": "bidding-cluster",
        "Match": {
          "Path": "/api/bids/{**catch-all}"
        }
      },
      "bidding-hub-route": {
        "ClusterId": "bidding-cluster",
        "Match": {
          "Path": "/hubs/bidding"
        }
      },
      "bidding-hub-catchall-route": {
        "ClusterId": "bidding-cluster",
        "Match": {
          "Path": "/hubs/bidding/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "tendering-cluster",
        "Match": {
          "Path": "/api/categories"
        }
      },
      "categories-catchall-route": {
        "ClusterId": "tendering-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "notifications-catchall-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notification-hub-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notification-hub"
        }
      },
      "notification-hub-catchall-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notification-hub/{**catch-all}"
        }
      },
      "wallet-route": {
        "ClusterId": "wallet-cluster",
        "Match": {
          "Path": "/api/wallet/{**catch-all}"
        }
      },
      "mail-route": {
        "ClusterId": "mail-cluster",
        "Match": {
          "Path": "/api/email/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://auth-service/"
          }
        }
      },
      "tendering-cluster": {
        "Destinations": {
          "tendering-service": {
            "Address": "http://tendering-service/"
          }
        }
      },
      "auction-cluster": {
        "Destinations": {
          "auction-service": {
            "Address": "http://auction-service/"
          }
        }
      },
      "bidding-cluster": {
        "Destinations": {
          "bidding-service": {
            "Address": "http://bidding-service/"
          }
        }
      },
      "wallet-cluster": {
        "Destinations": {
          "wallet-service": {
            "Address": "http://wallet-service/"
          }
        }
      },
      "mail-cluster": {
        "Destinations": {
          "mail-service": {
            "Address": "http://mail-service/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "http://notification-service/"
          }
        }
      }
    }
  }
}
